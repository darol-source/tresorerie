DATABASE_URL=mysql+pymysql://root:motdepasse@localhost:3306/tresorerie?charset=utf8mb4
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
ACCESS_TOKEN_MINUTES=480
SEUIL_VALIDATION_DIRECTEUR=500000
CORS_ORIGINS=http://localhost:5173
# Assistant IA (cle a creer sur console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Fournisseur de l'assistant : anthropic (defaut) | ollama (gratuit, local) | openai (API compatible OpenAI) ----
AGENT_PROVIDER=anthropic

# Option gratuite et locale : Ollama (https://ollama.com)
#   ollama pull qwen2.5:7b
# AGENT_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192

# Fournisseurs en ligne compatibles OpenAI (verifier leurs conditions et limites gratuites) :
# AGENT_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ---- Rappels par e-mail aux clients (creances) ----
# Exemple Gmail : creer un "mot de passe d'application" (validation en deux etapes requise)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=tsiarorollio@gmail.com
SMTP_PASSWORD=MKIXTGGETYSKPZPK
SMTP_FROM=tsiarorollio@gmail.com
SMTP_REPLY_TO=
SOCIETE_NOM=SITMA
SOCIETE_CONTACT=Tel : 0388435238
# Envoi automatique (laisser false tant que vous n'avez pas teste)
RAPPELS_AUTO=false
RAPPELS_HEURE=8
# Jours par rapport a l'echeance : -3 = 3 jours avant, 0 = le jour J, 1/7/15 = jours de retard
RAPPELS_CALENDRIER=-3,0,1,7,15
# Mode test : tous les e-mails partent vers CETTE adresse au lieu des clients
EMAIL_TEST_DESTINATAIRE=tsiarorollio@gmail.com
